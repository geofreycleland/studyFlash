let activeDeck = 0;
let deck = [];
let retryPile = [];
let knownCount = 0;
let passCount = 1;
let current = null;
let flipped = false;
let revealed = false;
let totalCards = 0;

function shuffle(arr) {
  const a = [...arr];
  for (let i = a.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [a[i], a[j]] = [a[j], a[i]];
  }
  return a;
}

function selectDomain(idx) {
  if (idx !== 0) return;
  activeDeck = idx;
  document.querySelectorAll('.tab').forEach((t, i) => {
    if (!t.classList.contains('coming-soon')) t.classList.toggle('active', i === idx);
  });
  restart();
}

function init() {
  totalCards = allDecks[activeDeck].length;
  deck = shuffle(allDecks[activeDeck]);
  retryPile = [];
  knownCount = 0;
  passCount = 1;
  document.getElementById('quizArea').style.display = 'flex';
  document.getElementById('doneScreen').classList.remove('visible');
  showCard();
  updateProgress();
}

function showCard() {
  if (deck.length === 0 && retryPile.length === 0) { showDone(); return; }
  if (deck.length === 0) {
    passCount++;
    deck = shuffle([...retryPile]);
    retryPile = [];
  }
  current = deck[0];
  flipped = false;
  revealed = false;
  document.getElementById('flashcard').classList.remove('flipped');
  document.getElementById('defText').textContent = current.def;
  document.getElementById('answerText').textContent = current.answer;
  document.getElementById('categoryText').textContent = current.category;
  document.getElementById('actions').classList.add('hidden');
  document.getElementById('preFlipActions').style.visibility = 'visible';
  updateProgress();
}

function flipCard() {
  flipped = !flipped;
  document.getElementById('flashcard').classList.toggle('flipped', flipped);
  if (flipped && !revealed) {
    revealed = true;
    document.getElementById('actions').classList.remove('hidden');
    document.getElementById('preFlipActions').style.visibility = 'hidden';
  }
  if (!flipped && revealed) {
    document.getElementById('preFlipActions').style.visibility = 'hidden';
  }
}

function gotIt() {
  deck.shift();
  knownCount++;
  showCard();
}

function dontKnow() {
  retryPile.push(deck.shift());
  showCard();
}

function updateProgress() {
  const pct = totalCards > 0 ? Math.round((knownCount / totalCards) * 100) : 0;
  document.getElementById('progressFill').style.width = pct + '%';
  document.getElementById('progressKnown').textContent = knownCount + ' of ' + totalCards + ' known';

  const retryCount = retryPile.length;
  const retryEl = document.getElementById('retryBadge');
  if (retryCount > 0) {
    retryEl.style.display = 'flex';
    document.getElementById('retryCount').textContent = retryCount;
  } else {
    retryEl.style.display = 'none';
  }

  const remaining = deck.length + retryPile.length;
  const cardNum = totalCards - remaining + 1;
  document.getElementById('cardCounter').textContent = 'Card ' + Math.min(cardNum, totalCards) + ' / ' + totalCards;
}

function showDone() {
  document.getElementById('quizArea').style.display = 'none';
  document.getElementById('doneScreen').classList.add('visible');
  document.getElementById('statKnown').textContent = knownCount;
  document.getElementById('statTotal').textContent = totalCards;
  document.getElementById('statPasses').textContent = passCount;
  const perfect = knownCount === totalCards;
  document.getElementById('doneTitle').textContent = perfect ? 'Perfect score!' : 'Deck complete!';
  document.getElementById('doneSub').textContent = perfect
    ? 'You knew every card on this domain. Add Domain 2 when ready!'
    : 'Keep going — you can restart and the cards you missed will come back around.';
}

function restart() { init(); }

init();
</script>

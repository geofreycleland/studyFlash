<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>AWS SAA-C03 Flashcards</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Share+Tech+Mono&family=VT323&family=Press+Start+2P&display=swap" rel="stylesheet">
<style>
  :root {
    --bg: #050a05;
    --surface: #091209;
    --surface2: #0d1a0d;
    --border: #1a3a1a;
    --accent: #00ff41;
    --accent-dim: #001a07;
    --accent-glow: rgba(0,255,65,0.15);
    --green: #00ff41;
    --green-dim: #002a0d;
    --amber: #ffb800;
    --amber-dim: #2a1f00;
    --red: #ff3b3b;
    --red-dim: #2a0505;
    --text: #c8ffb0;
    --text2: #5a9a5a;
    --text3: #2d5a2d;
    --mono: 'Share Tech Mono', monospace;
    --pixel: 'Press Start 2P', monospace;
    --vt: 'VT323', monospace;
    --radius: 4px;
    --radius-sm: 2px;
  }

  * { box-sizing: border-box; margin: 0; padding: 0; -webkit-tap-highlight-color: transparent; }

  html, body {
    height: 100%;
    background: var(--bg);
    color: var(--text);
    font-family: var(--mono);
  }

  /* CRT scanlines overlay */
  body::before {
    content: '';
    position: fixed;
    top: 0; left: 0; right: 0; bottom: 0;
    background: repeating-linear-gradient(
      0deg,
      transparent,
      transparent 2px,
      rgba(0,0,0,0.18) 2px,
      rgba(0,0,0,0.18) 4px
    );
    pointer-events: none;
    z-index: 9999;
  }

  /* CRT vignette */
  body::after {
    content: '';
    position: fixed;
    top: 0; left: 0; right: 0; bottom: 0;
    background: radial-gradient(ellipse at center, transparent 60%, rgba(0,0,0,0.75) 100%);
    pointer-events: none;
    z-index: 9998;
  }

  body {
    display: flex;
    flex-direction: column;
    min-height: 100dvh;
    overflow-x: hidden;
  }

  /* Phosphor flicker animation */
  @keyframes flicker {
    0%, 95%, 100% { opacity: 1; }
    96% { opacity: 0.92; }
    97% { opacity: 1; }
    98% { opacity: 0.95; }
  }

  @keyframes blink {
    0%, 49% { opacity: 1; }
    50%, 100% { opacity: 0; }
  }

  @keyframes glow-pulse {
    0%, 100% { text-shadow: 0 0 4px var(--accent), 0 0 10px var(--accent), 0 0 20px rgba(0,255,65,0.4); }
    50% { text-shadow: 0 0 2px var(--accent), 0 0 6px var(--accent), 0 0 12px rgba(0,255,65,0.2); }
  }

  @keyframes scanline-move {
    0% { transform: translateY(-100%); }
    100% { transform: translateY(100vh); }
  }

  /* Moving scanline */
  .scanline {
    position: fixed;
    top: 0; left: 0; right: 0;
    height: 40px;
    background: linear-gradient(transparent, rgba(0,255,65,0.03), transparent);
    animation: scanline-move 6s linear infinite;
    pointer-events: none;
    z-index: 9997;
  }

  /* Top bar */
  .topbar {
    padding: 14px 16px 12px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid var(--border);
    flex-shrink: 0;
    position: relative;
    animation: flicker 8s infinite;
  }

  .topbar::before {
    content: '> AWS_SAA-C03.EXE';
    position: absolute;
    top: -1px;
    left: 16px;
    font-family: var(--pixel);
    font-size: 6px;
    color: var(--text3);
    letter-spacing: 0.05em;
  }

  .topbar-left { display: flex; flex-direction: column; gap: 4px; padding-top: 8px; }

  .topbar-title {
    font-family: var(--pixel);
    font-size: 9px;
    color: var(--accent);
    letter-spacing: 0.08em;
    text-shadow: 0 0 6px var(--accent), 0 0 14px rgba(0,255,65,0.5);
    animation: glow-pulse 3s ease-in-out infinite;
  }

  .topbar-sub {
    font-family: var(--vt);
    font-size: 16px;
    color: var(--text2);
    letter-spacing: 0.1em;
  }

  .topbar-sub::before { content: '[ '; }
  .topbar-sub::after { content: ' ]'; }

  .card-counter {
    font-family: var(--vt);
    font-size: 20px;
    color: var(--accent);
    text-shadow: 0 0 8px var(--accent);
    letter-spacing: 0.05em;
  }

  /* Progress */
  .progress-wrap { padding: 10px 16px; flex-shrink: 0; }

  .progress-bar-bg {
    height: 6px;
    background: var(--border);
    border: 1px solid var(--text3);
    overflow: hidden;
    position: relative;
  }

  .progress-bar-fill {
    height: 100%;
    background: var(--accent);
    box-shadow: 0 0 8px var(--accent), 0 0 16px rgba(0,255,65,0.4);
    transition: width 0.5s steps(20, end);
  }

  .progress-meta { display: flex; justify-content: space-between; margin-top: 5px; }

  .progress-meta span {
    font-family: var(--vt);
    font-size: 16px;
    color: var(--text2);
    letter-spacing: 0.08em;
  }

  /* Domain tabs */
  .domain-tabs {
    display: flex;
    gap: 4px;
    padding: 0 16px 12px;
    overflow-x: auto;
    scrollbar-width: none;
    flex-shrink: 0;
  }
  .domain-tabs::-webkit-scrollbar { display: none; }

  .tab {
    flex-shrink: 0;
    padding: 4px 10px;
    border-radius: 0;
    border: 1px solid var(--text3);
    font-family: var(--vt);
    font-size: 15px;
    letter-spacing: 0.05em;
    color: var(--text3);
    background: transparent;
    cursor: pointer;
    transition: all 0.1s;
    white-space: nowrap;
    text-transform: uppercase;
  }

  .tab:hover:not(.coming-soon) {
    color: var(--accent);
    border-color: var(--accent);
    background: var(--accent-dim);
    box-shadow: 0 0 6px rgba(0,255,65,0.2), inset 0 0 6px rgba(0,255,65,0.05);
  }

  .tab.active {
    background: var(--accent-dim);
    border-color: var(--accent);
    color: var(--accent);
    box-shadow: 0 0 8px rgba(0,255,65,0.3), inset 0 0 8px rgba(0,255,65,0.08);
    text-shadow: 0 0 6px var(--accent);
  }

  .tab.coming-soon { opacity: 0.3; cursor: not-allowed; }

  /* Main card area */
  .card-area {
    flex: 1;
    display: flex;
    flex-direction: column;
    padding: 0 16px;
    justify-content: center;
    min-height: 0;
  }

  .card-scene {
    perspective: 1200px;
    margin-bottom: 16px;
  }

  .flashcard {
    width: 100%;
    min-height: 260px;
    position: relative;
    transform-style: preserve-3d;
    transition: transform 0.5s cubic-bezier(0.4, 0, 0.2, 1);
    cursor: pointer;
  }
  .flashcard.flipped { transform: rotateY(180deg); }

  .card-face {
    position: absolute;
    width: 100%;
    min-height: 260px;
    border-radius: var(--radius);
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    padding: 20px;
    display: flex;
    flex-direction: column;
    border: 1px solid var(--border);
    position: absolute;
  }

  .card-front {
    background: var(--surface);
    border-color: var(--text3);
    box-shadow: 0 0 16px rgba(0,255,65,0.08), inset 0 0 30px rgba(0,0,0,0.5);
  }

  .card-front::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--accent), transparent);
    opacity: 0.6;
  }

  .card-back {
    background: var(--surface2);
    transform: rotateY(180deg);
    border-color: var(--accent);
    box-shadow: 0 0 20px rgba(0,255,65,0.15), inset 0 0 30px rgba(0,0,0,0.4);
  }

  .card-back::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--accent), transparent);
  }

  .card-chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--vt);
    font-size: 16px;
    color: var(--text3);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin-bottom: 14px;
  }

  .chip-dot {
    width: 8px;
    height: 8px;
    background: var(--text3);
    animation: blink 1.2s step-end infinite;
  }

  .card-back .chip-dot { background: var(--accent); box-shadow: 0 0 6px var(--accent); }
  .card-back .card-chip { color: var(--accent); text-shadow: 0 0 6px rgba(0,255,65,0.5); }

  .card-def {
    font-family: var(--mono);
    font-size: 13.5px;
    line-height: 1.75;
    color: var(--text);
    flex: 1;
    text-shadow: 0 0 2px rgba(0,255,65,0.3);
  }

  .card-hint {
    margin-top: 14px;
    font-family: var(--vt);
    font-size: 15px;
    color: var(--text3);
    display: flex;
    align-items: center;
    gap: 8px;
    letter-spacing: 0.08em;
    animation: blink 1.5s step-end infinite;
  }

  .card-hint::before { content: '_'; }

  .card-answer {
    font-family: var(--vt);
    font-size: 26px;
    color: var(--accent);
    line-height: 1.3;
    margin-bottom: 8px;
    flex: 1;
    display: flex;
    align-items: center;
    text-shadow: 0 0 8px var(--accent), 0 0 20px rgba(0,255,65,0.4);
    letter-spacing: 0.05em;
  }

  .card-category-tag {
    display: inline-block;
    padding: 2px 8px;
    border-radius: 0;
    background: transparent;
    border: 1px solid var(--text3);
    color: var(--text2);
    font-family: var(--vt);
    font-size: 14px;
    letter-spacing: 0.08em;
    margin-bottom: 14px;
  }

  /* Action buttons */
  .actions {
    display: flex;
    gap: 8px;
    flex-shrink: 0;
    padding-bottom: 20px;
  }
  .actions.hidden { visibility: hidden; pointer-events: none; }

  .btn {
    flex: 1;
    padding: 12px 8px;
    border-radius: 0;
    border: 1px solid var(--text3);
    font-family: var(--vt);
    font-size: 16px;
    font-weight: normal;
    letter-spacing: 0.05em;
    cursor: pointer;
    transition: all 0.1s;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 3px;
    background: var(--surface);
    color: var(--text2);
    text-transform: uppercase;
    position: relative;
    overflow: hidden;
  }

  .btn::after {
    content: '';
    position: absolute;
    inset: 0;
    background: currentColor;
    opacity: 0;
    transition: opacity 0.1s;
  }

  .btn:active::after { opacity: 0.1; }
  .btn:active { transform: translateY(1px); }
  .btn-icon { font-size: 20px; line-height: 1; }

  .btn-know {
    background: var(--green-dim);
    border-color: var(--green);
    color: var(--green);
    box-shadow: 0 0 8px rgba(0,255,65,0.15);
    text-shadow: 0 0 6px var(--green);
  }

  .btn-retry {
    background: var(--red-dim);
    border-color: var(--red);
    color: var(--red);
    box-shadow: 0 0 8px rgba(255,59,59,0.15);
    text-shadow: 0 0 6px var(--red);
  }

  .btn-flip {
    background: var(--surface);
    border-color: var(--text3);
    color: var(--text2);
  }

  .btn-flip:hover {
    border-color: var(--accent);
    color: var(--accent);
    box-shadow: 0 0 8px rgba(0,255,65,0.2);
  }

  /* Done screen */
  .done-screen {
    display: none;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 40px 20px;
    text-align: center;
    flex: 1;
  }
  .done-screen.visible { display: flex; }

  .done-icon {
    font-size: 48px;
    margin-bottom: 20px;
    filter: drop-shadow(0 0 12px rgba(0,255,65,0.5));
  }

  .done-title {
    font-family: var(--pixel);
    font-size: 11px;
    color: var(--accent);
    margin-bottom: 12px;
    text-shadow: 0 0 8px var(--accent), 0 0 20px rgba(0,255,65,0.4);
    animation: glow-pulse 2s ease-in-out infinite;
    letter-spacing: 0.05em;
  }

  .done-sub {
    font-family: var(--vt);
    font-size: 18px;
    color: var(--text2);
    line-height: 1.5;
    max-width: 300px;
    margin: 0 auto 28px;
    letter-spacing: 0.05em;
  }

  .stats-row { display: flex; gap: 10px; margin-bottom: 28px; }

  .stat {
    background: var(--surface);
    border: 1px solid var(--border);
    border-top: 1px solid var(--accent);
    padding: 12px 18px;
    min-width: 80px;
  }

  .stat-num {
    font-family: var(--vt);
    font-size: 36px;
    color: var(--accent);
    text-shadow: 0 0 10px var(--accent);
    line-height: 1;
  }

  .stat-lbl {
    font-family: var(--vt);
    font-size: 14px;
    color: var(--text3);
    margin-top: 4px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .btn-restart {
    padding: 12px 32px;
    border-radius: 0;
    border: 1px solid var(--accent);
    background: var(--accent-dim);
    color: var(--accent);
    font-family: var(--pixel);
    font-size: 9px;
    letter-spacing: 0.08em;
    cursor: pointer;
    text-shadow: 0 0 6px var(--accent);
    box-shadow: 0 0 12px rgba(0,255,65,0.2);
    transition: all 0.1s;
    text-transform: uppercase;
  }

  .btn-restart:hover {
    background: rgba(0,255,65,0.1);
    box-shadow: 0 0 20px rgba(0,255,65,0.35);
  }

  .btn-restart:active { transform: translateY(1px); }

  /* Retry pile badge */
  .retry-badge {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-family: var(--vt);
    font-size: 16px;
    color: var(--amber);
    margin-left: auto;
    text-shadow: 0 0 6px var(--amber);
    letter-spacing: 0.05em;
  }

  .retry-dot {
    width: 6px; height: 6px;
    background: var(--amber);
    box-shadow: 0 0 6px var(--amber);
    animation: blink 0.8s step-end infinite;
  }
</style>
</head>
<body>
<div class="scanline"></div>

<div class="topbar">
  <div class="topbar-left">
    <span class="topbar-title">AWS SAA-C03</span>
    <span class="topbar-sub">FLASHCARD DECK</span>
  </div>
  <span class="card-counter" id="cardCounter">— / —</span>
</div>

<div class="progress-wrap">
  <div class="progress-bar-bg">
    <div class="progress-bar-fill" id="progressFill" style="width:0%"></div>
  </div>
  <div class="progress-meta">
    <span id="progressKnown">0 known</span>
    <span id="retryBadge" style="display:none">
      <span class="retry-dot"></span> <span id="retryCount">0</span> to retry
    </span>
  </div>
</div>

<div class="domain-tabs">
  <button class="tab active" onclick="selectDomain(0)">Domain 1 — Secure</button>
  <button class="tab coming-soon" title="Coming soon">Domain 2 — Resilient</button>
  <button class="tab coming-soon" title="Coming soon">Domain 3 — High Perf</button>
  <button class="tab coming-soon" title="Coming soon">Domain 4 — Cost Opt</button>
</div>

<div class="card-area" id="quizArea">
  <div class="card-scene">
    <div class="flashcard" id="flashcard" onclick="flipCard()">
      <div class="card-face card-front">
        <div class="card-chip"><span class="chip-dot"></span>Definition</div>
        <div class="card-def" id="defText"></div>
        <div class="card-hint">TAP TO REVEAL ANSWER</div>
      </div>
      <div class="card-face card-back">
        <div class="card-chip"><span class="chip-dot"></span>Answer</div>
        <div class="card-category-tag" id="categoryText"></div>
        <div class="card-answer" id="answerText"></div>
      </div>
    </div>
  </div>

  <div class="actions hidden" id="actions">
    <button class="btn btn-retry" onclick="dontKnow()">
      <span class="btn-icon">↩</span>
      <span>RETRY</span>
    </button>
    <button class="btn btn-flip" onclick="flipCard()">
      <span class="btn-icon">⟳</span>
      <span>FLIP</span>
    </button>
    <button class="btn btn-know" onclick="gotIt()">
      <span class="btn-icon">✓</span>
      <span>GOT IT</span>
    </button>
  </div>

  <div class="actions" id="preFlipActions" style="visibility:visible">
    <button class="btn btn-flip" style="flex:1" onclick="flipCard()">
      <span class="btn-icon">⟳</span>
      <span>TAP CARD OR FLIP TO REVEAL</span>
    </button>
  </div>
</div>

<div class="done-screen" id="doneScreen">
  <div class="done-icon">🎉</div>
  <div class="done-title" id="doneTitle">Deck complete!</div>
  <div class="done-sub" id="doneSub"></div>
  <div class="stats-row">
    <div class="stat"><div class="stat-num" id="statKnown">0</div><div class="stat-lbl">Known</div></div>
    <div class="stat"><div class="stat-num" id="statTotal">0</div><div class="stat-lbl">Total</div></div>
    <div class="stat"><div class="stat-num" id="statPasses">0</div><div class="stat-lbl">Passes</div></div>
  </div>
  <button class="btn-restart" onclick="restart()">[ START OVER ]</button>
</div>

<script>
const allDecks = [
  // Domain 1 — Design Secure Architectures
  [
    { answer: "AWS Site-to-Site VPN", category: "Networking & Access Control", def: "Creates an encrypted IPsec tunnel between your on-premises network and your Amazon VPC over the public internet, enabling secure hybrid connectivity that is fast to deploy." },
    { answer: "Application Load Balancer (ALB)", category: "Networking & Access Control", def: "A load balancer that operates at the request level (Layer 7), routing HTTP and HTTPS traffic to targets such as EC2 instances, containers, and Lambda functions based on request content." },
    { answer: "NAT Gateway", category: "Networking & Access Control", def: "A managed, highly available Network Address Translation service that enables instances in a private subnet to initiate outbound traffic to the internet while preventing inbound connections from the internet." },
    { answer: "Internet Gateway", category: "Networking & Access Control", def: "A horizontally scaled, redundant, highly available VPC component that allows communication between your VPC and the internet. It serves as a target in route tables for internet-routable traffic." },
    { answer: "Amazon VPC", category: "Networking & Access Control", def: "A logically isolated section of the AWS Cloud where you can launch AWS resources in a virtual network that you define, with full control over IP address ranges, subnets, route tables, and network gateways." },
    { answer: "VPC Gateway Endpoint", category: "Networking & Access Control", def: "A gateway you specify in your route table to allow private communication between your VPC and supported AWS services (S3 and DynamoDB) without requiring an internet gateway or NAT device." },
    { answer: "VPC Interface Endpoint", category: "Networking & Access Control", def: "An elastic network interface with a private IP address that serves as an entry point for traffic destined to a supported AWS service, powered by AWS PrivateLink — keeping traffic off the public internet." },
    { answer: "AWS WAF", category: "Networking & Access Control", def: "A web application firewall that helps protect your web applications or APIs against common web exploits and bots that may affect availability, compromise security, or consume excessive resources." },
    { answer: "AWS Global Accelerator", category: "Networking & Access Control", def: "A networking service that uses the AWS global network to route traffic to optimal regional endpoints, providing two static anycast IP addresses and improving availability and performance for global users." },
    { answer: "Network Load Balancer (NLB)", category: "Networking & Access Control", def: "A load balancer that operates at the connection level (Layer 4), routing TCP, UDP, and TLS traffic to targets with ultra-low latency — capable of handling millions of requests per second." },
    { answer: "AWS VPC Lattice", category: "Networking & Access Control", def: "A fully managed application networking service that simplifies service-to-service connectivity, security, and monitoring across VPCs and accounts, with built-in support for HTTPS listeners and service discovery." },
    { answer: "AWS PrivateLink", category: "Networking & Access Control", def: "A technology that provides private connectivity between VPCs and AWS services or your own services, keeping all traffic on the Amazon network without exposing it to the public internet." },
    { answer: "Network ACL (NACL)", category: "Networking & Access Control", def: "An optional, stateless layer of security for your VPC that acts as a firewall for controlling traffic in and out of one or more subnets. Rules are evaluated in number order and allow or deny traffic explicitly." },
    { answer: "Security Groups", category: "Networking & Access Control", def: "A stateful virtual firewall that controls inbound and outbound traffic at the instance level. All rules are evaluated before deciding whether to allow traffic, and return traffic is automatically allowed." },
    { answer: "AWS Transit Gateway", category: "Networking & Access Control", def: "A network transit hub that interconnects VPCs and on-premises networks through a central gateway, simplifying your network architecture and reducing the number of connections you need to manage." },
    { answer: "AWS IAM", category: "Identity & Access Management", def: "A service that enables you to manage access to AWS services and resources securely, controlling who is authenticated (signed in) and authorized (has permissions) to use AWS resources — available at no additional charge." },
    { answer: "AWS IAM Identity Center", category: "Identity & Access Management", def: "A service that makes it easy to centrally manage single sign-on (SSO) access to multiple AWS accounts and business applications, integrating with your existing workforce identity source." },
    { answer: "AWS Organizations / SCPs", category: "Identity & Access Management", def: "An account management service for consolidating multiple AWS accounts into an organization. Service Control Policies (SCPs) set maximum permission guardrails for all accounts within the organization." },
    { answer: "AWS Control Tower", category: "Identity & Access Management", def: "A service that offers the easiest way to set up and govern a secure, multi-account AWS environment (landing zone) based on AWS best practices, with preventive and detective guardrails for ongoing governance." },
    { answer: "Amazon Cognito", category: "Identity & Access Management", def: "A service that provides user sign-up, sign-in, and access control to your web and mobile applications. It supports millions of users and federated identity from social and enterprise identity providers." },
    { answer: "Lambda@Edge", category: "Identity & Access Management", def: "A feature of Amazon CloudFront that lets you run Lambda functions at AWS edge locations in response to CloudFront events — enabling low-latency authentication and authorization at the edge globally." },
    { answer: "AWS Directory Service / AD Connector", category: "Identity & Access Management", def: "AWS Directory Service provides managed Microsoft Active Directory in the AWS Cloud. AD Connector is a directory gateway that redirects directory requests to your existing on-premises Microsoft Active Directory without caching data in the cloud." },
    { answer: "AWS KMS", category: "Data Protection & Encryption", def: "A managed service that makes it easy to create and control cryptographic keys used to encrypt your data, with built-in integration across AWS services and centralized key management with optional automatic rotation." },
